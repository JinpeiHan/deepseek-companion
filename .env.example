# OpenAI-compatible image endpoint used by scripts/generate-openai-assets.mjs
#
# Copy this file to .env and fill both values in. .env is git-ignored and the
# key is only ever held in process memory; every error message the generator
# prints runs through redact() first.
#
# The base URL must be the /v1 root, not a full endpoint path. The generator
# appends /models and /images/edits itself.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
